{
  "[scala]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.semanticHighlighting.enabled": true
  },
  "files.associations": {
    "*.sbt": "scala",
    "*.sc": "scala"
  },
  "metals.inlayHints.enabled": "true",
  "metals.enableSemanticHighlighting": true,
  "metals.showImplicitConversions": "false",
  "files.watcherExclude": {
    "**/target/**": true
  },
  "metals.inlayHints.inferredTypes.enable": true,
  "metals.inlayHints.typeParameters.enable": true,
  "metals.inlayHints.implicitArguments.enable": true
}
